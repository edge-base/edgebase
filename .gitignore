# Playwright
.playwright/

# Generated test/runtime output
artifacts/
.release-artifacts/
# Local development output stays ignored, but the audited release drivers are
# source files. Credential files under dev/release remain ignored by the
# earlier .env/.env.* rules and by the allowlist below.
/dev/*
!/dev/testing/
!/dev/release/
/dev/release/*
!/dev/release/*.mjs
!/dev/release/README.md
/functions/
/runtime/
*.log
erl_crash.dump
test-results/
test_out.txt
unity-hub-crop*.png
.tmp/
