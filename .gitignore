!packages/create-edgebase/bin/
!packages/create-edgebase/bin/create-edgebase.js
obj/
vendor/
composer.lock
target/
Cargo.lock

# C++ SDK generated artifacts
packages/sdk/cpp/.vs/
packages/sdk/cpp/Binaries/
