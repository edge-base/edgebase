{
    "name": "@edge-base/dashboard",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "svelte-kit sync && vite build",
        "dev": "vite dev",
        "preview": "vite preview",
        "lint": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "test": "vitest run && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "test:ui": "vitest run",
        "test:e2e": "playwright test",
        "test:e2e:headed": "playwright test --headed",
        "test:e2e:live": "playwright test --config playwright.live.config.ts",
        "test:e2e:live:headed": "playwright test --config playwright.live.config.ts --headed"
    },
    "devDependencies": {
        "@codemirror/autocomplete": "^6.20.3",
        "@codemirror/commands": "^6.10.4",
        "@codemirror/lang-html": "^6.4.9",
        "@codemirror/lang-sql": "^6.10.0",
        "@codemirror/language": "^6.12.4",
        "@codemirror/state": "^6.7.1",
        "@codemirror/theme-one-dark": "^6.1.3",
        "@codemirror/view": "^6.43.6",
        "@playwright/test": "^1.61.1",
        "@sveltejs/adapter-static": "^3.0.8",
        "@sveltejs/kit": "^2.70.1",
        "@sveltejs/vite-plugin-svelte": "^7.2.0",
        "@testing-library/jest-dom": "^6.0.0",
        "@testing-library/svelte": "^5.4.2",
        "jsdom": "^29.1.1",
        "svelte": "^5.56.6",
        "svelte-check": "^4.7.3",
        "typescript": "^7.0.2",
        "vite": "^8.1.5",
        "vitest": "^4.1.10"
    }
}
