<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <RootNamespace>EdgeBase.Unity</RootNamespace>
    <AssemblyName>EdgeBase.Unity</AssemblyName>
    <Nullable>enable</Nullable>
    <LangVersion>10.0</LangVersion>
    <PackageId>dev.edgebase.unity</PackageId>
    <Version>0.5.0</Version>
    <Description>EdgeBase Unity client SDK for .NET Standard 2.1 - auth, database, realtime, rooms, storage, functions, analytics, and push</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://edgebase.fun/docs/database/client-sdk</PackageProjectUrl>
    <RepositoryUrl>https://github.com/edge-base/edgebase/tree/main/packages/sdk/csharp/packages/unity</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../core/EdgeBase.Core.csproj" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="llms.txt" Pack="true" PackagePath="" />
    <!-- TurnstileAdapters is intentionally compiled by Unity, where platform
         define symbols and WebView plugin assemblies are available. The
         package DLL is built outside Unity, so omitting this source would make
         every built-in adapter dead code for NuGet consumers. -->
    <None Include="TurnstileAdapters.cs"
          Pack="true"
          PackagePath="content/Assets/EdgeBase/Runtime/TurnstileAdapters.cs" />
    <None Update="Assets/**/*"
          Pack="true"
          PackagePath="content/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="tests/**" />
  </ItemGroup>
</Project>
