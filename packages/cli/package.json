{
    "name": "@edge-base/cli",
    "version": "0.5.0",
    "description": "CLI for EdgeBase — create, develop, and deploy EdgeBase projects",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/edge-base/edgebase.git",
        "directory": "packages/cli"
    },
    "homepage": "https://github.com/edge-base/edgebase/tree/main/packages/cli",
    "bugs": "https://github.com/edge-base/edgebase/issues",
    "keywords": [
        "edgebase",
        "cli",
        "baas",
        "backend",
        "cloudflare-workers"
    ],
    "publishConfig": {
        "access": "public"
    },
    "type": "module",
    "bin": {
        "edgebase": "./dist/index.js"
    },
    "main": "./dist/index.js",
    "files": [
        "dist",
        "llms.txt"
    ],
    "scripts": {
        "build": "tsc && node ./scripts/copy-assets.mjs",
        "lint": "eslint src/ test/ --max-warnings 0",
        "test": "vitest run --exclude test/build-app.test.ts --exclude test/pack.test.ts --exclude test/pack-distribution.test.ts && vitest run test/build-app.test.ts && vitest run test/pack.test.ts && vitest run test/pack-distribution.test.ts",
        "test:compat": "vitest run --exclude test/build-app.test.ts --exclude test/pack.test.ts --exclude test/pack-distribution.test.ts && vitest run test/build-app.test.ts && vitest run test/pack-distribution.test.ts",
        "test:pack-smoke": "node ./scripts/pack-smoke.mjs",
        "test:docker-smoke": "node ./scripts/docker-smoke.mjs",
        "dev": "tsc --watch",
        "prepack": "pnpm run build"
    },
    "engines": {
        "node": ">=22.0.0"
    },
    "dependencies": {
        "@edge-base/server": "workspace:*",
        "@edge-base/shared": "workspace:*",
        "chalk": "^5.4.0",
        "commander": "^15.0.0",
        "esbuild": "^0.28.1",
        "jose": "^6.2.4",
        "ora": "^9.4.1",
        "pg": "^8.22.0",
        "tsx": "^4.23.1",
        "ts-morph": "^28.0.0",
        "wrangler": "4.114.0"
    },
    "devDependencies": {
        "@types/node": "^26.1.1",
        "typescript": "^7.0.2",
        "vitest": "^4.1.10"
    }
}
