{
    "name": "@edge-base/server",
    "version": "0.5.0",
    "description": "EdgeBase runtime assets consumed by the EdgeBase CLI",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/edge-base/edgebase.git",
        "directory": "packages/server"
    },
    "homepage": "https://github.com/edge-base/edgebase/tree/main/packages/server",
    "bugs": "https://github.com/edge-base/edgebase/issues",
    "keywords": [
        "edgebase",
        "runtime",
        "server",
        "cloudflare-workers"
    ],
    "publishConfig": {
        "access": "public"
    },
    "type": "module",
    "main": "./src/index.ts",
    "files": [
        "src",
        "admin-build",
        "openapi.json"
    ],
    "scripts": {
        "build": "tsc --noEmit",
        "lint": "eslint src/ --max-warnings 0",
        "test": "vitest run --config vitest.unit.config.ts",
        "test:integration": "./scripts/run-integration-shards.sh",
        "bench": "vitest run --config vitest.bench.config.ts",
        "dev": "./scripts/dev.sh",
        "dev:raw": "wrangler dev",
        "test:e2e": "vitest run --config vitest.e2e.config.ts",
        "prepack": "pnpm --dir ../admin build && pnpm run build && node ./scripts/copy-admin-build.mjs"
    },
    "engines": {
        "node": ">=22.0.0"
    },
    "dependencies": {
        "@edge-base/core": "workspace:*",
        "@edge-base/shared": "workspace:*",
        "@hono/zod-openapi": "^1.5.1",
        "@simplewebauthn/server": "^13",
        "bcryptjs": "^3.0.3",
        "hono": "4.12.31",
        "jose": "^6.2.3",
        "pg": "^8.22.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@cloudflare/vitest-pool-workers": "^0.18.6",
        "@cloudflare/workers-types": "5.20260719.1",
        "@stryker-mutator/core": "^9.6.1",
        "@stryker-mutator/typescript-checker": "^9.6.1",
        "@stryker-mutator/vitest-runner": "^9.6.1",
        "@types/pg": "^8.20.0",
        "@types/ws": "^8.18.1",
        "@vitest/runner": "4.1.10",
        "@vitest/snapshot": "4.1.10",
        "@vitest/coverage-v8": "4.1.10",
        "fast-check": "^4.9.0",
        "typescript": "^7.0.2",
        "vitest": "^4.1.10",
        "wrangler": "4.114.0",
        "ws": "^8.21.1"
    }
}
